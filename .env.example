# Robot hardware + safety params for the MCP server.
# The model / OpenRouter key / chat channels live in openclaw.config.json5, NOT here.

# --- Robot network ---
# TRIK motor controller (receives UDP "linear,angular")
TRIK_IP=192.168.50.248
TRIK_PORT=5005
# Lidar scan bridge broadcasts JSON on this UDP port
BRIDGE_PORT=5006

# --- Safety caps ---
MAX_LINEAR=0.6          # m/s, absolute cap on linear speed
MAX_ANGULAR=1.0         # rad/s, absolute cap on angular speed
CMD_TIMEOUT_S=2.0       # s, motion auto-stops after this (deadman)
ESTOP_DISTANCE_M=0.35   # m, block forward motion if obstacle closer than this
LIDAR_STALE_S=1.5       # s, lidar considered disconnected if no scan within this
