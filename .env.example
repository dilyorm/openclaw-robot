# Robot hardware + safety params for the MCP server.
# The model / OpenRouter key / chat channels live in openclaw.config.json5, NOT here.

# --- Robot network ---
# TRIK motor controller (receives UDP "linear,angular").
# Direct ethernet link (Pi eth0 <-> TRIK): set this to the TRIK's IP on that link.
TRIK_IP=192.168.50.248
TRIK_PORT=5005
# Lidar scan bridge broadcasts JSON on this UDP port (only used if LIDAR_ENABLED).
BRIDGE_PORT=5006

# --- Lidar ---
# false on robots without a lidar: skips the scan listener and the e-stop /
# fail-safe forward-block. Set true only when the scan_bridge is running.
LIDAR_ENABLED=false

# --- Safety caps ---
MAX_LINEAR=0.6          # m/s, absolute cap on linear speed
MAX_ANGULAR=1.0         # rad/s, absolute cap on angular speed
CMD_TIMEOUT_S=2.0       # s, motion auto-stops after this (deadman)
ESTOP_DISTANCE_M=0.35   # m, block forward motion if obstacle closer than this (lidar only)
LIDAR_STALE_S=1.5       # s, lidar considered disconnected if no scan within this
